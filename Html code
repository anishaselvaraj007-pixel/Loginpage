<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KPRCAS Login</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:linear-gradient(135deg,#0d47a1,#42a5f5);
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
}

.login-box{
    background:#fff;
    width:350px;
    padding:30px;
    border-radius:15px;
    box-shadow:0 10px 25px rgba(0,0,0,0.3);
    text-align:center;
}

.logo{
    width:130px;
    margin-bottom:15px;
}

h2{
    color:#0d47a1;
    margin-bottom:20px;
}

.input-box{
    width:100%;
    margin:12px 0;
}

.input-box input{
    width:100%;
    padding:12px;
    border:1px solid #ccc;
    border-radius:8px;
    outline:none;
    font-size:16px;
}

.input-box input:focus{
    border-color:#0d47a1;
}

button{
    width:100%;
    padding:12px;
    border:none;
    border-radius:8px;
    background:#0d47a1;
    color:white;
    font-size:16px;
    cursor:pointer;
    transition:0.3s;
}

button:hover{
    background:#1565c0;
}

.links{
    margin-top:15px;
}

.links a{
    text-decoration:none;
    color:#0d47a1;
    font-size:14px;
}

.footer{
    margin-top:20px;
    color:#777;
    font-size:13px;
}
</style>

</head>
<body>

<div class="login-box">

<img src="Screenshot_20260724_054856_Google.jpg" class="logo" alt="KPRCAS Logo">

<h2>KPRCAS Student Login</h2>

<form>

<div class="input-box">
<input type="text" placeholder="Register Number" required>
</div>

<div class="input-box">
<input type="password" placeholder="Password" required>
</div>

<button type="submit">Login</button>

<div class="links">
<a href="#">Forgot Password?</a>
</div>

</form>

<div class="footer">
© 2026 KPRCAS | Learn Beyond
</div>

</div>

</body>
</html>
